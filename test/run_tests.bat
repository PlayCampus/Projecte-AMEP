@echo off
REM Script para ejecutar la suite de tests de PlayCampus
REM ==================================================

echo.
echo ??????????????????????????????????????????????????????????????
echo ?  PlayCampus - Suite de Tests Unitaris                     ?
echo ?  Google Test Framework                                     ?
echo ??????????????????????????????????????????????????????????????
echo.

REM Verificar que existeix l'executable
if not exist "test.exe" (
    echo ERROR: No s'ha trobat test.exe
    echo Assegureu-vos de compilar primer el projecte amb:
    echo   msbuild Playcampus.sln /p:Configuration=Debug /p:Platform=x64
    goto :end
)

REM Menú d'opcions
:menu
echo.
echo Opcions disponibles:
echo [1] Executar TOTS els tests
echo [2] Executar tests d'ENTITATS
echo [3] Executar tests de LÒGICA DE NEGOCI
echo [4] Executar tests de REGLES DE NEGOCI
echo [5] Llistar tots els tests disponibles
echo [6] Executar amb output XML (per a CI/CD)
echo [7] Sortir
echo.

set /p choice="Selecciona una opció (1-7): "

if "%choice%"=="1" goto all_tests
if "%choice%"=="2" goto entity_tests
if "%choice%"=="3" goto business_logic_tests
if "%choice%"=="4" goto business_rules_tests
if "%choice%"=="5" goto list_tests
if "%choice%"=="6" goto xml_output
if "%choice%"=="7" goto end

echo ERROR: Opció no vàlida. Tria entre 1 i 7.
goto menu

REM ====== OPCIÓ 1: Executar TOTS els tests ======
:all_tests
echo.
echo Executant TOTS els tests...
echo ????????????????????????????????????????????????????????????
test.exe --gtest_print_time=true
goto after_test

REM ====== OPCIÓ 2: Tests d'ENTITATS ======
:entity_tests
echo.
echo Executant tests d'ENTITATS (JugadorTest, TemporadaTest, etc.)
echo ????????????????????????????????????????????????????????????
test.exe --gtest_filter="JugadorTest*" --gtest_print_time=true
test.exe --gtest_filter="TemporadaTest*" --gtest_print_time=true
test.exe --gtest_filter="JornadaTest*" --gtest_print_time=true
test.exe --gtest_filter="AdministradorTest*" --gtest_print_time=true
test.exe --gtest_filter="IntegracioEntitatsTest*" --gtest_print_time=true
test.exe --gtest_filter="EdgeCasesTest*" --gtest_print_time=true
goto after_test

REM ====== OPCIÓ 3: Tests de LÒGICA DE NEGOCI ======
:business_logic_tests
echo.
echo Executant tests de LÒGICA DE NEGOCI (Controladors, Validacions)
echo ????????????????????????????????????????????????????????????
test.exe --gtest_filter="CtrlCrearPartitTest*" --gtest_print_time=true
test.exe --gtest_filter="CtrlIniciSessioTest*" --gtest_print_time=true
test.exe --gtest_filter="CtrlEnregistrarEquipTest*" --gtest_print_time=true
test.exe --gtest_filter="CtrlCrearLligaTest*" --gtest_print_time=true
test.exe --gtest_filter="CtrlCrearTemporadaTest*" --gtest_print_time=true
test.exe --gtest_filter="ValidacioDataTest*" --gtest_print_time=true
test.exe --gtest_filter="ComparacioTest*" --gtest_print_time=true
goto after_test

REM ====== OPCIÓ 4: Tests de REGLES DE NEGOCI ======
:business_rules_tests
echo.
echo Executant tests de REGLES DE NEGOCI
echo ????????????????????????????????????????????????????????????
test.exe --gtest_filter="ReglesPartitTest*" --gtest_print_time=true
test.exe --gtest_filter="ReglesEquipTest*" --gtest_print_time=true
test.exe --gtest_filter="ClasificacioTest*" --gtest_print_time=true
test.exe --gtest_filter="ValidacioJornadaTest*" --gtest_print_time=true
test.exe --gtest_filter="ValidacioCapitaTest*" --gtest_print_time=true
test.exe --gtest_filter="ValidacioAdminTest*" --gtest_print_time=true
test.exe --gtest_filter="TestConvocatoriaTest*" --gtest_print_time=true
test.exe --gtest_filter="EstadistiquesJugadorTest*" --gtest_print_time=true
test.exe --gtest_filter="LimitsConstraintsTest*" --gtest_print_time=true
goto after_test

REM ====== OPCIÓ 5: LLISTAR tests disponibles ======
:list_tests
echo.
echo Llistant tots els tests disponibles...
echo ????????????????????????????????????????????????????????????
test.exe --gtest_list_tests
goto after_test

REM ====== OPCIÓ 6: OUTPUT XML (per a CI/CD) ======
:xml_output
echo.
echo Executant tests amb output XML (test_results.xml)...
echo ????????????????????????????????????????????????????????????
test.exe --gtest_output="xml:test_results.xml"
echo.
echo ? Resultats guardats en: test_results.xml
goto after_test

REM ====== AFTER TEST ======
:after_test
echo.
echo ????????????????????????????????????????????????????????????
echo.
pause
goto menu

REM ====== SORTIR ======
:end
echo.
echo Fins aviat!
echo.
exit /b 0
